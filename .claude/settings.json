{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git *)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_git_convention.py\"",
            "timeout": 10,
            "statusMessage": "Checking commit convention"
          }
        ]
      }
    ]
  }
}

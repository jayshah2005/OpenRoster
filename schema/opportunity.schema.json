{
  "$defs": {
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/CostKind",
          "default": "unknown"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "Cost",
      "type": "object"
    },
    "CostKind": {
      "enum": [
        "free",
        "paid",
        "unknown"
      ],
      "title": "CostKind",
      "type": "string"
    },
    "Eligibility": {
      "enum": [
        "open_to_all",
        "school_only",
        "high_school",
        "undergrad",
        "grad",
        "unknown"
      ],
      "title": "Eligibility",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 500,
          "title": "Text",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "text",
        "url"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Geo": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "source": {
          "default": "gazetteer",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Geo",
      "type": "object"
    },
    "HistoryEntry": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "old": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Old"
        },
        "new": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "New"
        }
      },
      "required": [
        "at",
        "field",
        "old",
        "new"
      ],
      "title": "HistoryEntry",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "venue_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue Name"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "region": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "country": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "in_person",
        "online",
        "hybrid",
        "unknown"
      ],
      "title": "Mode",
      "type": "string"
    },
    "NearSchool": {
      "additionalProperties": false,
      "properties": {
        "school_id": {
          "title": "School Id",
          "type": "string"
        },
        "km": {
          "title": "Km",
          "type": "number"
        }
      },
      "required": [
        "school_id",
        "km"
      ],
      "title": "NearSchool",
      "type": "object"
    },
    "Obtained": {
      "enum": [
        "ics",
        "rss",
        "tribe",
        "localist",
        "jsonld",
        "sitemap",
        "html",
        "headless",
        "api",
        "hackathon_site",
        "submission",
        "manual"
      ],
      "title": "Obtained",
      "type": "string"
    },
    "OppType": {
      "enum": [
        "hackathon",
        "info_session",
        "tech_talk",
        "career_fair",
        "networking",
        "workshop",
        "conference",
        "case_competition",
        "early_career_program",
        "other"
      ],
      "title": "OppType",
      "type": "string"
    },
    "RegRoute": {
      "enum": [
        "public_link",
        "school_portal_login",
        "form",
        "email",
        "unknown"
      ],
      "title": "RegRoute",
      "type": "string"
    },
    "Registration": {
      "additionalProperties": false,
      "properties": {
        "route": {
          "$ref": "#/$defs/RegRoute",
          "default": "unknown"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "Registration",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "title": "Review",
      "type": "object"
    },
    "Role": {
      "enum": [
        "participant",
        "volunteer",
        "mentor",
        "judge",
        "organizer_team",
        "workshop_lead"
      ],
      "title": "Role",
      "type": "string"
    },
    "RoleStatus": {
      "enum": [
        "upcoming",
        "open",
        "closed",
        "unknown"
      ],
      "title": "RoleStatus",
      "type": "string"
    },
    "RoleWindow": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/$defs/Role"
        },
        "opens": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opens"
        },
        "closes": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closes"
        },
        "status": {
          "$ref": "#/$defs/RoleStatus",
          "default": "unknown"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "evidence": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        }
      },
      "required": [
        "role"
      ],
      "title": "RoleWindow",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "adapter": {
          "$ref": "#/$defs/Obtained"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        }
      },
      "required": [
        "url",
        "adapter",
        "source_id",
        "fetched_at"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Status": {
      "enum": [
        "scheduled",
        "moved",
        "cancelled",
        "needs_review",
        "past"
      ],
      "title": "Status",
      "type": "string"
    },
    "TravelSupport": {
      "additionalProperties": false,
      "properties": {
        "stated": {
          "default": false,
          "title": "Stated",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "TravelSupport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,120}$",
      "title": "Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/OppType"
    },
    "title": {
      "maxLength": 200,
      "minLength": 2,
      "title": "Title",
      "type": "string"
    },
    "organizer": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Organizer",
      "type": "string"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/RoleWindow"
      },
      "minItems": 1,
      "title": "Roles",
      "type": "array"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    },
    "end": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "all_day": {
      "default": false,
      "title": "All Day",
      "type": "boolean"
    },
    "series_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Series Id"
    },
    "mode": {
      "$ref": "#/$defs/Mode",
      "default": "unknown"
    },
    "location": {
      "$ref": "#/$defs/Location"
    },
    "geo": {
      "anyOf": [
        {
          "$ref": "#/$defs/Geo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "near_schools": {
      "items": {
        "$ref": "#/$defs/NearSchool"
      },
      "title": "Near Schools",
      "type": "array"
    },
    "schools": {
      "items": {
        "type": "string"
      },
      "title": "Schools",
      "type": "array"
    },
    "eligibility": {
      "items": {
        "$ref": "#/$defs/Eligibility"
      },
      "title": "Eligibility",
      "type": "array"
    },
    "registration": {
      "$ref": "#/$defs/Registration"
    },
    "cost": {
      "$ref": "#/$defs/Cost"
    },
    "travel_support": {
      "$ref": "#/$defs/TravelSupport"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "summary": {
      "default": "",
      "maxLength": 200,
      "title": "Summary",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "obtained_via": {
      "items": {
        "$ref": "#/$defs/Obtained"
      },
      "minItems": 1,
      "title": "Obtained Via",
      "type": "array"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "title": "Last Seen",
      "type": "string"
    },
    "last_verified": {
      "format": "date-time",
      "title": "Last Verified",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "default": "scheduled"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/HistoryEntry"
      },
      "title": "History",
      "type": "array"
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/Review"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ai_suggested": {
      "description": "Field names filled by an AI suggestion",
      "items": {
        "type": "string"
      },
      "title": "Ai Suggested",
      "type": "array"
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "organizer",
    "roles",
    "start",
    "timezone",
    "sources",
    "obtained_via",
    "first_seen",
    "last_seen",
    "last_verified"
  ],
  "title": "Opportunity",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jayshah2005/OpenRoster/schema/opportunity.schema.json"
}
